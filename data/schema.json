{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoeyHammoth/semiconductor-bandgap-belvedere/data/schema.json",
  "title": "Band-Gap Observatory diode run",
  "description": "One constant-current diode thermometry run. Temperatures are stored in Celsius and converted to kelvin by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "material",
    "device",
    "recorded_at",
    "instrument",
    "samples",
    "provenance"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+-[a-z0-9]+-[0-9]{8}-[0-9]{2}$",
      "description": "Stable identifier, also the filename stem."
    },
    "material": {
      "enum": ["ge", "si", "led-red", "led-green", "led-blue"]
    },
    "device": {
      "type": "string",
      "minLength": 1,
      "description": "Part number, e.g. 1N4007, 1N60P."
    },
    "recorded_at": {
      "type": "string",
      "format": "date"
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adc_fsr_v", "adc_bits", "r_set_ohm", "r_temp_ohm", "supply_v"],
      "properties": {
        "adc_fsr_v": { "type": "number", "exclusiveMinimum": 0 },
        "adc_bits": { "type": "integer", "minimum": 8, "maximum": 32 },
        "r_set_ohm": { "type": "number", "exclusiveMinimum": 0 },
        "r_temp_ohm": { "type": "number", "exclusiveMinimum": 0 },
        "r1_ohm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "supply_v": { "type": "number", "exclusiveMinimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t_s", "adc_counts", "voltage_v", "current_a", "temp_c"],
      "properties": {
        "t_s": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 1
        },
        "adc_counts": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 1
        },
        "voltage_v": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "current_a": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 1
        },
        "temp_c": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "lm234_current_a": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "notes": { "type": "string" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "consent"],
      "properties": {
        "operator": { "type": "string", "minLength": 1 },
        "consent": {
          "enum": ["granted", "pending", "denied"],
          "description": "Publication consent for data derived from coursework."
        },
        "attribution": { "type": "string" },
        "source_file": { "type": "string" }
      }
    }
  }
}
